#!/usr/bin/env sh
# Git pre-commit hook
# Runs fast checks: typecheck + lint (staged files only) + knip
# Enforces small, atomic commits (max 10 files, 200 lines)
# Skip with: git commit --no-verify

set -eu

START_TIME=$(date +%s)
MAX_FILES=10
MAX_LINES=200

echo "🔍 Running pre-commit checks..."

# Check if bun is available
if ! command -v bun > /dev/null 2>&1; then
    echo "⚠️  bun not found, skipping checks"
    exit 0
fi

# ── Commit size guard ──
STAGED_FILES=$(git diff --cached --name-only | wc -l)
STAGED_LINES=$(git diff --cached --stat | tail -1 | awk '{print $4}' || echo "0")

if [ "$STAGED_FILES" -gt "$MAX_FILES" ]; then
    echo "❌ Commit too large: $STAGED_FILES files staged (max: $MAX_FILES)"
    echo "   Split into smaller, atomic commits."
    exit 1
fi

if [ "$STAGED_LINES" -gt "$MAX_LINES" ]; then
    echo "❌ Commit too large: ~$STAGED_LINES lines changed (max: $MAX_LINES)"
    echo "   Split into smaller, atomic commits."
    exit 1
fi

# ── Dependency version guard ──
# Enforce pinned versions in package.json (no ^ or ~ ranges)
# Dependencies must be managed via bun commands which respect bunfig.toml
if git diff --cached --name-only | grep -q "package.json"; then
    echo "  🔒 Checking dependency versions..."
    if git diff --cached -- package.json | grep -E '^\+.*".*":\s*"[\^~]' > /dev/null 2>&1; then
        echo "❌ Found unpinned dependency versions (^ or ~) in package.json"
        echo "   Use 'bun add <pkg>@<version>' instead of editing manually."
        echo "   Bun will respect exact=true from bunfig.toml."
        exit 1
    fi
fi

# Run typecheck
echo "  📝 Type checking..."
if ! bun run typecheck; then
    echo "❌ Typecheck failed"
    exit 1
fi

# Run lint on staged files only (via lint-staged)
echo "  🧹 Linting staged files..."
if ! bunx lint-staged; then
    echo "❌ Lint failed"
    exit 1
fi

# Run knip (dead code check)
echo "  🔍 Dead code check..."
if ! bun run knip; then
    echo "❌ Knip failed (unused deps/exports)"
    exit 1
fi

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

echo "✅ Pre-commit checks passed (${ELAPSED}s)"
