{
  "name": "swipe-pad-app",
  "version": "0.1.0",
  "private": true,
  "trustedDependencies": [],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --config eslint.config.mjs --fix",
    "*.css": "stylelint --fix"
  },
  "scripts": {
    "dev": "next dev --port 3030",
    "build": "next build",
    "start": "next start",
    "lint": "bunx eslint . --config eslint.config.mjs",
    "lint:css": "stylelint \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "bun run typecheck && bun run lint && bun run lint:css && bun run knip",
    "actions:lint": "actionlint",
    "actions:ci": "nix run .#gha-local -- -W .github/workflows/ci.yml",
    "actions:checks": "nix run .#gha-local -- -W .github/workflows/ci.yml -j checks",
    "actions:build": "nix run .#gha-local -- -W .github/workflows/ci.yml -j build",
    "actions:contracts": "nix run .#gha-local -- -W .github/workflows/ci.yml -j contracts",
    "wagmi:generate": "PATH=\"$HOME/.foundry/bin:$PATH\" wagmi generate --config wagmi-cli.config.ts",
    "contracts:build": "cd contracts && forge build",
    "test": "bun test ./src/app ./src/lib",
    "test:watch": "bun test --watch ./src/app ./src/lib",
    "test:e2e": "bun test ./src/test/e2e-routing.test.ts",
    "test:e2e:strict": "E2E_REQUIRE_FEED_DATA=1 bun run test:e2e",
    "test:ui:e2e": "playwright test",
    "test:all": "bun run test && bun run test:e2e",
    "env:dev": "sops exec-env secrets/dev.env.sops 'bun run dev'",
    "env:decrypt:dev": "sops decrypt secrets/dev.env.sops > .env.local",
    "secrets:scan": "git diff --cached | gitleaks stdin --no-banner --redact && git diff | gitleaks stdin --no-banner --redact",
    "secrets:scan:history": "gitleaks git . --no-banner --redact",
    "seed:e2e:feed": "bun run scripts/seed-e2e-feed.ts",
    "import:ui-lab:json": "bun run scripts/import-ui-lab-json.ts",
    "contracts:test": "cd contracts && forge test",
    "contracts:deploy:anvil": "cd contracts && forge script script/Deploy.s.sol --rpc-url http://localhost:8545 --broadcast",
    "contracts:deploy:celo": "cd contracts && forge script script/Deploy.s.sol --rpc-url $CELO_RPC --broadcast --verify",
    "contracts:deploy:base": "cd contracts && forge script script/Deploy.s.sol --rpc-url $BASE_RPC --broadcast --verify"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@farcaster/miniapp-sdk": "0.3.0",
    "@farcaster/miniapp-wagmi-connector": "2.0.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.101.0",
    "@vercel/analytics": "2.0.1",
    "autoprefixer": "10.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "convex": "1.40.0",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "12.40.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.17.0",
    "next": "16.2.7",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "7.77.0",
    "react-resizable-panels": "4.11.2",
    "react-swipeable": "7.0.2",
    "recharts": "3.8.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "thirdweb": "5.120.0",
    "vaul": "1.1.2",
    "wagmi": "3.6.16",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/bun": "1.3.9",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "25.0.10",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@wagmi/cli": "2.9.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-better-tailwindcss": "4.0.2",
    "eslint-plugin-boundaries": "5.4.0",
    "knip": "5.85.0",
    "lint-staged": "17.0.4",
    "postcss": "8.5.6",
    "sharp": "0.34.5",
    "stylelint": "17.3.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
