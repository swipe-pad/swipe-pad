#!/bin/bash
#
# SwipePad Pre-commit Hook
# Detecta secrets con gitleaks antes de cada commit
#
# Instalación:
#   cp scripts/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔒 SwipePad pre-commit hook"
echo "   Running secret scan with gitleaks..."

# Check if gitleaks is installed
if ! command -v gitleaks &> /dev/null; then
    echo "${YELLOW}⚠️  gitleaks not found in PATH${NC}"
    echo "   Install with: brew install gitleaks"
    echo "   Or: docker pull ghcr.io/gitleaks/gitleaks:latest"
    echo "   Skipping secret scan..."
    exit 0
fi

# Scan staged changes
echo "   Scanning staged changes..."
if git diff --cached | gitleaks stdin --no-banner --redact -v; then
    echo "${GREEN}✅ No secrets detected in staged changes${NC}"
else
    echo "${RED}❌ Potential secret detected in staged changes!${NC}"
    echo ""
    echo "   If this is a false positive, you can:"
    echo "   1. Add 'gitleaks:allow' comment to the line"
    echo "   2. Update .gitleaksignore with the fingerprint"
    echo "   3. Skip hook with: SKIP=gitleaks git commit -m '...'"
    echo ""
    exit 1
fi

echo ""
echo "${GREEN}✅ Pre-commit checks passed${NC}"
