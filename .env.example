# ClickUp Integration
CLICKUP_API_TOKEN=your_clickup_api_token
CLICKUP_CLIENT_SECRET=your_clickup_client_secret

# Thirdweb Configuration
# Client ID is public - used in browser for wallet connection
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# Secret Key is server-only - used for account abstraction backend
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key

# Convex Configuration
# Automatically set by `bun convex dev`, but needed for production/CI
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Admin Controls (Convex)
ADMIN_API_KEY=your_admin_api_key
ADMIN_WALLETS=0xabc...,0xdef...

# Talent Protocol Integration
# Required for syncing builder scores (v3 API)
TALENT_PROTOCOL_API_KEY=your_talent_protocol_api_key

# Foundry / Deploy
CELO_RPC=https://forno.celo.org
BASE_RPC=https://mainnet.base.org
CELOSCAN_KEY=your_celoscan_api_key
BASESCAN_KEY=your_basescan_api_key
PRIVATE_KEY=your_deployer_private_key
OWNER_ADDRESS=0x...
TOKEN_ADDRESS=0x...
CELO_MULTISIG=0x...
BASE_MULTISIG=0x...
